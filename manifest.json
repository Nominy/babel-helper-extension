{
  "manifest_version": 3,
  "name": "Babel Audio Workflow Helper",
  "version": "1.0.279",
  "key": "",
  "description": "Workflow shortcuts and quick actions for the Babel Audio transcription dashboard.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Open Babel Helper settings",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://dashboard.babel.audio/*"
      ],
      "js": [
        "dist/content/mod-host.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://dashboard.babel.audio/*"
      ],
      "js": [
        "dist/content/entry.js"
      ],
      "css": [
        "dist/content/website-appearance.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/content/magnifier-bridge.js",
        "dist/content/lazy-session.js",
        "dist/content/playback-bridge.js",
        "dist/content/recovered-editor-bridge.js",
        "dist/content/timestamp-bridge.js",
        "dist/content/linter-bridge.js",
        "dist/content/quick-region-autocomplete-bridge.js",
        "dist/content/waveform-theme-bridge.js"
      ],
      "matches": [
        "https://dashboard.babel.audio/*"
      ]
    }
  ]
}
